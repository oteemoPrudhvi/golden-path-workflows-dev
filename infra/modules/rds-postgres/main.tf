# =============================================================================
# RDS POSTGRESQL — Backstage catalog, scaffolder tasks, search
# =============================================================================
# Backstage ships with SQLite, which is local-development only. Any shared
# environment needs Postgres; app-config.production.yaml already expects
# POSTGRES_HOST / PORT / USER / PASSWORD.
#
# AC: "RDS PostgreSQL is reachable from the Backstage cluster and not
# reachable from the public internet."
# =============================================================================

resource "aws_db_subnet_group" "this" {
  name       = "${var.name_prefix}-backstage-db"
  subnet_ids = var.subnet_ids

  tags = merge(var.tags, { Name = "${var.name_prefix}-backstage-db-subnets" })
}

resource "aws_security_group" "this" {
  name        = "${var.name_prefix}-backstage-db-sg"
  description = "Postgres access for the Backstage cluster only"
  vpc_id      = var.vpc_id

  tags = merge(var.tags, { Name = "${var.name_prefix}-backstage-db-sg" })

  lifecycle {
    create_before_destroy = true
  }
}

# Ingress by security group reference, not CIDR. If the cluster's addressing
# changes the rule stays correct, and nothing else in the VPC gains access.
resource "aws_vpc_security_group_ingress_rule" "postgres" {
  # Keys are the caller's labels, so they are known at plan time. The values
  # are security group ids that only exist after apply. See the variable
  # description for why this matters.
  for_each = var.allowed_security_groups

  security_group_id            = aws_security_group.this.id
  referenced_security_group_id = each.value
  from_port                    = 5432
  to_port                      = 5432
  ip_protocol                  = "tcp"
  description                  = "Postgres from ${each.key}"
}

# No egress rules. Postgres has no reason to initiate outbound connections,
# and the AWS default of allow-all egress is worth overriding here.

# --- Credentials -------------------------------------------------------------
# Generated by Terraform, stored in Secrets Manager, never written to code.
#
# NOTE: the password lands in Terraform state. State is encrypted and access
# controlled (see bootstrap), but that is why AC #10 says "no secrets in
# Terraform code or state OUTPUTS in plaintext" rather than "not in state" —
# the value is not exposed as an output, and the Secrets Manager ARN is what
# the application consumes.
resource "random_password" "master" {
  length = 32
  # RDS rejects several punctuation characters in master passwords. Restricting
  # the set avoids an apply that fails only after the instance starts creating.
  override_special = "!#$%&*()-_=+[]{}<>:?"
}

resource "aws_secretsmanager_secret" "db" {
  name        = "${var.name_prefix}/backstage/database"
  description = "Backstage Postgres credentials, consumed via External Secrets"

  # Zero means immediate deletion rather than the 7-30 day window. Required
  # for AC #15 — a destroy/apply cycle must not fail because the secret name
  # is still held in a pending-deletion state.
  recovery_window_in_days = 0

  tags = merge(var.tags, { Name = "${var.name_prefix}-backstage-db-secret" })
}

resource "aws_secretsmanager_secret_version" "db" {
  secret_id = aws_secretsmanager_secret.db.id

  # Shape matches what app-config.production.yaml expects, so External Secrets
  # can map keys straight to POSTGRES_* environment variables.
  secret_string = jsonencode({
    POSTGRES_HOST     = aws_db_instance.this.address
    POSTGRES_PORT     = tostring(aws_db_instance.this.port)
    POSTGRES_USER     = var.master_username
    POSTGRES_PASSWORD = random_password.master.result
    POSTGRES_DB       = var.database_name
  })
}

# --- Instance ----------------------------------------------------------------
locals {
  # One source of truth: the exports RDS is told to make, and the log groups we
  # create for them, cannot drift apart.
  log_exports = ["postgresql", "upgrade"]
}

# RDS creates /aws/rds/instance/<id>/<type> itself when an export is enabled, with no
# retention and no tags, outside Terraform's knowledge. The `upgrade` group only
# appears the first time an upgrade runs, so it would have leaked later, after the
# `postgresql` one was already noticed.
resource "aws_cloudwatch_log_group" "exports" {
  for_each = toset(local.log_exports)

  name              = "/aws/rds/instance/${var.name_prefix}-backstage/${each.key}"
  retention_in_days = var.log_retention_days

  tags = merge(var.tags, { Name = "${var.name_prefix}-backstage-db-${each.key}-logs" })
}

resource "aws_db_instance" "this" {
  identifier = "${var.name_prefix}-backstage"

  engine         = "postgres"
  engine_version = var.engine_version
  instance_class = var.instance_class

  allocated_storage = var.allocated_storage_gb
  # gp3 is cheaper than gp2 at this size and has better baseline throughput.
  storage_type      = "gp3"
  storage_encrypted = true

  db_name  = var.database_name
  username = var.master_username
  password = random_password.master.result

  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [aws_security_group.this.id]

  # AC: "not reachable from the public internet". The subnet group is private,
  # and this makes the intent explicit rather than implied by subnet choice.
  publicly_accessible = false

  multi_az = var.multi_az

  backup_retention_period = var.backup_retention_days
  backup_window           = "03:00-04:00"
  maintenance_window      = "Mon:04:00-Mon:05:00"

  # Minor versions only. A major version upgrade should be a deliberate,
  # reviewed change, never something a maintenance window performs overnight.
  auto_minor_version_upgrade  = true
  allow_major_version_upgrade = false

  deletion_protection = var.deletion_protection

  # Demo instance: skip the final snapshot so destroy is clean and quick.
  # AC #16 requires destroy to remove everything it created.
  skip_final_snapshot = true

  # Logs worth having when Backstage cannot connect or a migration hangs.
  enabled_cloudwatch_logs_exports = local.log_exports

  # The provider would otherwise propose a change on every plan once RDS
  # applies a minor version itself.
  lifecycle {
    ignore_changes = [engine_version]
  }

  tags = merge(var.tags, { Name = "${var.name_prefix}-backstage-db" })

  # The log groups must exist first, or RDS creates its own unmanaged ones.
  depends_on = [aws_cloudwatch_log_group.exports]
}
